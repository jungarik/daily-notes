# Bot service image: the Telegram adapter. A thin client that calls the API over
# the project's private network; it imports no services/stores/db of its own.
# (Installs the shared requirements.txt — a superset — for simplicity.)

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY . .

CMD ["python", "-m", "frontend.Telegram_Bot.bot"]
