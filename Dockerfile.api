# API service image: the FastAPI gateway (pure /api). The Telegram Mini App is
# deployed separately as a static host (Dockerfile.webapp) and calls this API
# cross-origin, so nothing frontend is built or served here.

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY . .

# Railway injects PORT; api.run binds dual-stack (:: + IPv4 edge).
CMD ["python", "-m", "api.run"]
