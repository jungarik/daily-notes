# Get a token from @BotFather on Telegram
BOT_TOKEN=123456:ABC-your-token-here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/notes

# OpenAI API key for generating chunk embeddings (semantic search)
OPENAI_API_KEY=sk-your-key-here

# Google Speech-to-Text API key (for transcribing voice messages)
GOOGLE_STT_API_KEY=your-google-api-key
# Language Google should expect in voice notes (BCP-47), e.g. uk-UA, en-US
STT_LANGUAGE_CODE=uk-UA
