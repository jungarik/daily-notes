# Get a token from @BotFather on Telegram
BOT_TOKEN=123456:ABC-your-token-here

# PostgreSQL connection string. REQUIRED by every service that touches the DB
# (bot and API). On Railway set it on each such service, referencing Postgres:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/notes
# Startup connection retry (used when running migrations) — tolerate a DB that
# isn't ready yet at deploy time.
DB_CONNECT_ATTEMPTS=10
DB_CONNECT_BACKOFF_SECONDS=3

# OpenAI API key — used for embeddings AND voice transcription
OPENAI_API_KEY=sk-your-key-here

# Voice transcription (OpenAI). whisper-1 accepts Telegram's OGG audio directly.
OPENAI_STT_MODEL=whisper-1
# Optional: force a language (ISO-639-1, e.g. uk). Leave empty to auto-detect.
OPENAI_STT_LANGUAGE=
# Optional: neutral transcription context (a personal note). Keep it generic —
# reminder detection is a separate step. An echo of this text is discarded.
# OPENAI_STT_PROMPT=Персональна нотатка користувача. A personal user note.

# Object storage for voice audio. Leave blank to skip storing audio.
# AWS S3:  leave S3_ENDPOINT_URL blank, set S3_REGION to the bucket's region.
# R2/MinIO: set S3_ENDPOINT_URL to the S3 API endpoint, S3_REGION=auto.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Default/fallback timezone for reminders (IANA name). Each chat can override
# it with the /timezone command; this is only used until they do.
REMINDER_TZ=Europe/Kyiv
# Default UI language until a chat sets its own with /language (en or uk)
BOT_DEFAULT_LOCALE=en

# Predefined default vault folders the enricher can choose from when no existing
# note path fits (comma-separated). The model weighs these alongside the user's
# existing paths from the DB.
DEFAULT_PATHS=Inbox,daily_notes,projects,areas,knowledge,sources
# Where a note lands when the model can't determine any path.
DEFAULT_NOTE_PATH=Inbox

# --- API service (separate Railway deployable) ---
# Enable Swagger docs at /docs (debugging only; keep false in production).
API_DOCS_ENABLED=false
# Shared secret guarding /internal endpoints (defence in depth on top of the
# private network). Generate a random value; set the SAME value on the API
# service and the bot service. Leave blank to disable the check (local dev).
API_INTERNAL_TOKEN=
# Bot → API base URL over Railway's private network. On Railway set it to
#   http://${{<ApiServiceName>.RAILWAY_PRIVATE_DOMAIN}}:8080
# Leave blank locally / until the bot is switched to call the API.
API_BASE_URL=
# Timeout (seconds) for the bot's outbound API calls.
API_TIMEOUT_SECONDS=10
# Model used only when rule-based reminder parsing can't pin a time
REMINDER_LLM_MODEL=gpt-4o-mini
# What an indefinite quantity means: "через кілька хвилин" → N minutes
REMINDER_FEW_COUNT=5
# What a vague "пізніше"/"later" resolves to (10m / 2h / 1d)
REMINDER_LATER=10m
# How often the background dispatcher checks for due reminders (seconds)
REMINDER_POLL_SECONDS=30
# A reminder stuck mid-send (crash) is reclaimed after this many seconds
REMINDER_SENDING_STALE_SECONDS=120
