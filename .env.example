# Get a token from @BotFather on Telegram
BOT_TOKEN=123456:ABC-your-token-here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/notes

# OpenAI API key — used for embeddings AND voice transcription
OPENAI_API_KEY=sk-your-key-here

# Voice transcription (OpenAI). whisper-1 accepts Telegram's OGG audio directly.
OPENAI_STT_MODEL=whisper-1
# Optional: force a language (ISO-639-1, e.g. uk). Leave empty to auto-detect.
OPENAI_STT_LANGUAGE=
# Optional: transcription context to bias spelling of names/terms.
# OPENAI_STT_PROMPT=Голосові нотатки українською та англійською

# Default/fallback timezone for reminders (IANA name). Each chat can override
# it with the /timezone command; this is only used until they do.
REMINDER_TZ=Europe/Kyiv
# Default UI language until a chat sets its own with /language (en or uk)
BOT_DEFAULT_LOCALE=en
# Model used only when rule-based reminder parsing can't pin a time
REMINDER_LLM_MODEL=gpt-4o-mini
# How often the background dispatcher checks for due reminders (seconds)
REMINDER_POLL_SECONDS=30
# A reminder stuck mid-send (crash) is reclaimed after this many seconds
REMINDER_SENDING_STALE_SECONDS=120
