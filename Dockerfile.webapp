# Standalone static hosting for the Mini App (the browser client). Build with
# VITE_BASE=/ (own origin) and VITE_API_BASE = the API's public origin, then
# serve the built dist/ with Caddy.
#
# Requires (on this service): set VITE_API_BASE to the API origin.
# And on the API service: add this service's public origin to
# WEBAPP_ALLOWED_ORIGINS (CORS).

FROM node:20-slim AS build
WORKDIR /webapp
COPY browser/webapp/package*.json ./
RUN npm install --no-audit --no-fund
COPY browser/webapp/ ./
ARG VITE_API_BASE=""
ENV VITE_BASE="/" VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /webapp/dist /srv
COPY browser/webapp/Caddyfile /etc/caddy/Caddyfile
# The caddy image's default CMD runs this Caddyfile; Railway injects $PORT.
